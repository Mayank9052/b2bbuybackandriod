{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\backend\\B2BBuyback.Api\\B2BBuyback.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}\\backend\\B2BBuyback.Api\\B2BBuyback.Api.csproj"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend\\B2BBuyback.Api"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: pub get",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\scripts\\flutter-with-git.cmd",
      "args": ["pub", "get"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "problemMatcher": []
    },

    // ── Auto-IP tasks (no hardcoded IP) ────────────────────────────────
    {
      "label": "frontend: run (USB - auto IP)",
      "type": "process",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\scripts\\run-flutter-device.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "show current LAN IP",
      "type": "process",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\scripts\\get-lan-ip.ps1"
      ],
      "problemMatcher": []
    },

    // ── Legacy tasks (hardcoded IP — update manually if needed) ────────
    {
      "label": "frontend: run",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\scripts\\flutter-with-git.cmd",
      "args": [
        "run",
        "--dart-define",
        "API_BASE_URL=http://10.0.2.2:5181"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: run (emulation)",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\scripts\\flutter-with-git.cmd",
      "args": [
        "run",
        "-d", "emulator",
        "--dart-define",
        "API_BASE_URL=http://10.0.2.2:5181"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },

    // ── Compound tasks ─────────────────────────────────────────────────
    {
      "label": "fullstack: run (USB - auto IP)",
      "dependsOn": ["backend: run", "frontend: run (USB - auto IP)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "fullstack: run (emulation)",
      "dependsOn": ["backend: run", "frontend: run (emulation)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}